// Cloudflare Workers configuration for the OpenNext adapter.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pnl404",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-08-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS",
    // Serve .html assets at their exact URL. The default strips the extension
    // with a 307, which breaks search-engine verification files that must
    // answer 200 at the URL the verifier was given.
    "html_handling": "none"
  },
  "observability": {
    "enabled": true
  }
}
